<Window x:Class="AirlineTicketOffice.Views.SuccessTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Успешное оформление" Height="220" Width="490"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Margin="-20,-20,-20,15" Padding="16,10">
            <TextBlock Text="Успешное оформление авиабилета" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="1" Margin="10,0,10,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="40" Height="40" Background="#D1FAE5" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="✓" Foreground="#059669" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Билет успешно оформлен!" Foreground="#065F46" FontSize="15" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="TicketNumberTextBlock" Text="Выписан электронный билет № 555-2418901235." Foreground="#1E293B" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="Маршрутная квитанция отправлена на печать и сохранена в реестре." Foreground="#64748B" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Готово" Width="100" Height="34" Background="#0284C7" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" IsDefault="True" IsCancel="True" Click="Close_Click">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
