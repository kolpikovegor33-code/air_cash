<Window x:Class="AirlineTicketOffice.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АИС «Авиакасса» — Главное рабочее место" Height="780" Width="1180"
        MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="WindowHeaderTextBlock" Text="АИС «Авиакасса» — Главное рабочее место кассира (Оператор: Иванов И.И.)"
                           Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="15,10">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="NavFlightsBtn" Content="✈  Расписание и поиск" Height="40" Padding="15,0"
                                Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13"
                                Cursor="Hand" Margin="0,0,8,0" Click="NavTab_Click" Tag="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="NavPassengersBtn" Content="👥  Пассажиры" Height="40" Padding="15,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="13"
                                Cursor="Hand" Margin="0,0,8,0" Click="NavTab_Click" Tag="1">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="NavTicketsBtn" Content="📋  Бронирования и билеты" Height="40" Padding="15,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="13"
                                Cursor="Hand" Margin="0,0,8,0" Click="NavTab_Click" Tag="2">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="NavRefundBtn" Content="🔄  Возврат билета" Height="40" Padding="15,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="13"
                                Cursor="Hand" Margin="0,0,8,0" Click="NavTab_Click" Tag="3">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="NavAnalyticsBtn" Content="📊  Аналитика руководителя" Height="40" Padding="15,0"
                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="13"
                                Cursor="Hand" Click="NavTab_Click" Tag="4">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock x:Name="CurrentUserNameTextBlock" Text="Пользователь: Иванов И.И." Foreground="#0F172A" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="CurrentUserRoleTextBlock" Text="(Кассир)" Foreground="#64748B" FontSize="11.5" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Button Content="Сменить пользователя" Height="36" Padding="12,0" Background="White" Foreground="#475569"
                                BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="Logout_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="15">
                <Grid x:Name="TabFlights" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Параметры поиска авиарейсов" Foreground="#0F172A" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Очистить фильтры" Foreground="#0284C7" FontSize="12.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" Cursor="Hand" MouseDown="ClearFilters_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2.0*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Город / Аэропорт вылета:" Foreground="#64748B" FontSize="11.5" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="FilterFromComboBox" Height="34" FontSize="12.5" VerticalContentAlignment="Center" SelectionChanged="AirportFilter_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Город / Аэропорт прилёта:" Foreground="#64748B" FontSize="11.5" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="FilterToComboBox" Height="34" FontSize="12.5" VerticalContentAlignment="Center" SelectionChanged="AirportFilter_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Дата вылета:" Foreground="#64748B" FontSize="11.5" Margin="0,0,0,3"/>
                                    <DatePicker x:Name="FilterDatePicker" Height="34" FontSize="12.5" SelectedDateChanged="AirportFilter_DateChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Авиакомпания:" Foreground="#64748B" FontSize="11.5" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="FilterAirlineComboBox" Height="34" FontSize="12.5" VerticalContentAlignment="Center" SelectionChanged="AirportFilter_SelectionChanged"/>
                                </StackPanel>

                                <Button Grid.Column="8" Content="🔍 Найти рейсы" Height="34" Background="#0284C7" Foreground="White"
                                        BorderThickness="0" FontWeight="Bold" FontSize="12.5" Cursor="Hand" VerticalAlignment="Bottom" Click="SearchFlights_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="FoundFlightsCountTextBlock" Text="Доступные рейсы (найдено: 5 рейсов):" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel x:Name="AdminFlightsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="➕ Добавить рейс" Height="32" Padding="12,0" Background="#10B981" Foreground="White"
                                            BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,8,0" Click="AddFlight_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="✏️ Редактировать рейс" Height="32" Padding="12,0" Background="#F1F5F9" Foreground="#334155"
                                            BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Margin="0,0,8,0" Click="EditFlight_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="🗑️ Удалить рейс" Height="32" Padding="12,0" Background="#FEE2E2" Foreground="#DC2626"
                                            BorderBrush="#FECACA" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="DeleteFlight_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="FlightsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0"
                                      RowHeight="36" FontSize="12.5" SelectionChanged="FlightsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№ Рейса" Binding="{Binding FlightNumber}" Width="90" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Авиакомпания" Binding="{Binding Airline.Title}" Width="150"/>
                                    <DataGridTextColumn Header="Маршрут" Binding="{Binding RouteDisplay}" Width="210"/>
                                    <DataGridTextColumn Header="Вылет" Binding="{Binding DepartureTimeDisplay}" Width="135"/>
                                    <DataGridTextColumn Header="Прилёт" Binding="{Binding ArrivalTimeDisplay}" Width="135"/>
                                    <DataGridTextColumn Header="Воздушное судно" Binding="{Binding Aircraft.Model}" Width="130"/>
                                    <DataGridTemplateColumn Header="Свободно мест" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#DCFCE7" CornerRadius="12" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding FreeSeatsDisplay}" Foreground="#15803D" FontWeight="Bold" FontSize="11.5"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Базовый тариф" Binding="{Binding BasePriceDisplay}" Width="110" FontWeight="SemiBold"/>
                                    <DataGridTemplateColumn Header="Статус" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Status}" Foreground="#0284C7" FontWeight="SemiBold" FontSize="11.5"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,10,0,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedFlightSummaryTextBlock"
                                       Text="Выбран рейс: SU-1124 (Москва → Сочи) | Тариф эконом: 6 450 ₽ | Бизнес: 18 900 ₽"
                                       Foreground="#0F172A" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="💳 Оформить и продать билет" Height="38" Padding="16,0" Background="#0284C7" Foreground="White"
                                        BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,8,0" Click="OpenBookingTicket_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="📑 Забронировать рейс (PNR)" Height="38" Padding="16,0" Background="#D97706" Foreground="White"
                                        BorderThickness="0" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,8,0" Click="OpenBookingTicket_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="Подробно о тарифах" Height="38" Padding="14,0" Background="White" Foreground="#475569"
                                        BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="12.5" Cursor="Hand" Click="TariffsInfo_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="TabPassengers" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1.0*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PassengerSearchTextBox" Height="36" FontSize="13" VerticalContentAlignment="Center"
                                         Padding="10,0" Text="" KeyDown="PassengerSearch_KeyDown"/>
                                <Button Grid.Column="1" Content="Найти" Margin="8,0,0,0" Height="36" Background="#0284C7" Foreground="White"
                                        BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="PassengerSearch_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Grid.Column="2" Content="Сброс" Margin="6,0,0,0" Height="36" Background="#F1F5F9" Foreground="#475569"
                                        BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" Click="PassengerReset_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="PassengersDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0"
                                      RowHeight="34" FontSize="12.5" SelectionChanged="PassengersDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО Пассажира" Binding="{Binding FullName}" Width="180" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Дата рожд." Binding="{Binding BirthDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="95"/>
                                    <DataGridTextColumn Header="Документ" Binding="{Binding DocumentNumber}" Width="120"/>
                                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" x:Name="TotalPassengersCountTextBlock"
                                       Text="Всего зарегистрировано пассажиров в базе: 1 482"
                                       Foreground="#64748B" FontSize="12" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Карточка персональных данных" Foreground="#0F172A" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

                            <TextBlock Text="Фамилия пассажира *:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="PassLastNameTextBox" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Имя *:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                    <TextBox x:Name="PassFirstNameTextBox" Height="34" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Отчество:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                    <TextBox x:Name="PassMiddleNameTextBox" Height="34" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Дата рождения *:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                    <DatePicker x:Name="PassBirthDatePicker" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Серия и номер паспорта РФ * (формат 1234 876678):" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                    <TextBox x:Name="PassDocTextBox" Height="34" FontSize="13" VerticalContentAlignment="Center" MaxLength="11" TextChanged="PassDocTextBox_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Контактный телефон:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="PassPhoneTextBox" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <TextBlock Text="Электронная почта (E-mail):" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox x:Name="PassEmailTextBox" Height="34" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Новый пассажир" Height="38" Background="#F1F5F9" Foreground="#334155"
                                        BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" Click="PassengerNew_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>

                                <Button Grid.Column="2" Content="💾 Сохранить изменения" Height="38" Background="#0284C7" Foreground="White"
                                        BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="PassengerSave_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>

                                <Button Grid.Column="4" Content="Удалить" Height="38" Padding="12,0" Background="#FEE2E2" Foreground="#DC2626"
                                        BorderBrush="#FECACA" FontWeight="SemiBold" Cursor="Hand" Click="PassengerDelete_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="TabTickets" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Реестр оформленных билетов и бронирований" Foreground="#0F172A" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="🔄 Обновить список" Height="34" Padding="14,0" Background="#F1F5F9" Foreground="#0284C7"
                                    BorderBrush="#CBD5E1" FontWeight="SemiBold" HorizontalAlignment="Right" Cursor="Hand" Click="RefreshTickets_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DataGrid x:Name="TicketsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="36" FontSize="12.5" Background="White" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№ Билета" Binding="{Binding TicketNumber}" Width="140" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Пассажир" Binding="{Binding Passenger.FullName}" Width="180"/>
                                <DataGridTextColumn Header="Рейс" Binding="{Binding Flight.FlightNumber}" Width="90"/>
                                <DataGridTextColumn Header="Маршрут" Binding="{Binding Flight.RouteDisplay}" Width="200"/>
                                <DataGridTextColumn Header="Дата/Время вылета" Binding="{Binding Flight.DepartureTimeDisplay}" Width="140"/>
                                <DataGridTextColumn Header="Место" Binding="{Binding SeatNumber}" Width="70" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Стоимость" Binding="{Binding Price, StringFormat=\{0:N2\} ₽}" Width="110"/>
                                <DataGridTemplateColumn Header="Статус" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" Foreground="#15803D" FontWeight="Bold" FontSize="11.5"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid x:Name="TabRefund" Visibility="Collapsed">
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="25" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Операция возврата авиабилета" Foreground="#0F172A" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="Поиск билета в реестре продаж для аннулирования и возврата денежных средств клиенту" Foreground="#64748B" FontSize="12.5" Margin="0,0,0,18"/>

                            <TextBlock Text="Введите номер электронного билета (13 знаков) или PNR-код:" Foreground="#334155" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RefundSearchTextBox" Text="555-2418901234" Height="38" FontSize="13.5" VerticalContentAlignment="Center" Padding="10,0"/>
                                <Button Grid.Column="1" Content="Найти" Margin="8,0,0,0" Height="38" Background="#0284C7" Foreground="White"
                                        BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="RefundSearch_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>

                            <Border x:Name="FoundTicketCardBorder" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock x:Name="RefundTicketTitle" Text="Билет № 555-2418901234" Foreground="#0F172A" FontSize="14" FontWeight="Bold"/>
                                        <Border x:Name="RefundTicketStatusBadge" Background="#DCFCE7" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="RefundTicketStatusText" Text="Оплачен" Foreground="#15803D" FontWeight="Bold" FontSize="11.5"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="RefundPassengerText" Text="Пассажир: Иванов Алексей Петрович | Паспорт: 4514 892341" Foreground="#334155" FontSize="13" Margin="0,3,0,3"/>
                                    <TextBlock x:Name="RefundFlightText" Text="Рейс: SU-1124 (Москва SVO → Сочи AER), Вылет: 05.11.2026 08:30" Foreground="#475569" FontSize="12.5" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="RefundSeatPriceText" Text="Место: 12A (Эконом) | Полная стоимость билета: 6 450.00 ₽" Foreground="#475569" FontSize="12.5"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="ProceedRefundBtn" Content="Оформить возврат билета" Height="42" Background="#DC2626" Foreground="White"
                                    BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="ProceedRefund_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="TabAnalytics" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Период отчёта:" Foreground="#64748B" FontSize="11.5" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="AnalyticsStartDatePicker" Height="34" SelectedDate="2026-10-01" SelectedDateChanged="AnalyticsFilter_DateChanged"/>
                                    <TextBlock Grid.Column="1" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <DatePicker x:Name="AnalyticsEndDatePicker" Height="34" SelectedDate="2026-11-30" SelectedDateChanged="AnalyticsFilter_DateChanged"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Тип отчётной формы:" Foreground="#64748B" FontSize="11.5" Margin="0,0,0,3"/>
                                <ComboBox x:Name="AnalyticsFormComboBox" Height="34" SelectedIndex="0" FontSize="12.5" VerticalContentAlignment="Center" SelectionChanged="AnalyticsForm_SelectionChanged">
                                    <ComboBoxItem Content="Сводный отчёт по продажам авиакассы"/>
                                    <ComboBoxItem Content="Отчёт по загрузке бортов и рейсов"/>
                                    <ComboBoxItem Content="Реестр возвратов и аннулирований"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Авиакомпания:" Foreground="#64748B" FontSize="11.5" Margin="0,0,0,3"/>
                                <ComboBox x:Name="AnalyticsAirlineComboBox" Height="34" FontSize="12.5" VerticalContentAlignment="Center" SelectionChanged="AnalyticsFilter_SelectionChanged"/>
                            </StackPanel>

                            <Button Grid.Column="6" Content="📊 Сформировать отчёт" Height="34" Background="#0284C7" Foreground="White"
                                    BorderThickness="0" FontWeight="Bold" FontSize="12.5" Cursor="Hand" VerticalAlignment="Bottom" Click="RefreshAnalytics_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Border Height="3" Background="#0284C7" Margin="-14,-14,-14,10" CornerRadius="7,7,0,0"/>
                                <TextBlock Text="ПРОДАНО БИЛЕТОВ" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="KpiSoldTicketsTextBlock" Text="0 шт." Foreground="#0F172A" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Border Height="3" Background="#10B981" Margin="-14,-14,-14,10" CornerRadius="7,7,0,0"/>
                                <TextBlock Text="СУММА ВЫРУЧКИ" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="KpiRevenueTextBlock" Text="0 ₽" Foreground="#0F172A" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Border Height="3" Background="#F59E0B" Margin="-14,-14,-14,10" CornerRadius="7,7,0,0"/>
                                <TextBlock Text="СРЕДНЯЯ ЗАГРУЗКА РЕЙСОВ" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="KpiLoadFactorTextBlock" Text="0.0%" Foreground="#0F172A" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" MouseLeftButtonUp="KpiRefundsCard_Click" ToolTip="Нажмите для перехода в Реестр возвратов и аннулирований">
                            <StackPanel>
                                <Border Height="3" Background="#EF4444" Margin="-14,-14,-14,10" CornerRadius="7,7,0,0"/>
                                <TextBlock Text="СУММА ВОЗВРАТОВ" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="KpiRefundsTextBlock" Text="0 ₽" Foreground="#0F172A" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DataGrid x:Name="AnalyticsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  RowHeight="36" FontSize="12.5" Background="White" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Авиакомпания" Binding="{Binding AirlineTitle}" Width="240" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Кол-во рейсов" Binding="{Binding FlightsCount}" Width="120"/>
                                <DataGridTextColumn Header="Продано мест" Binding="{Binding SeatsSold}" Width="120"/>
                                <DataGridTextColumn Header="Сумма тарифов" Binding="{Binding TariffsSum, StringFormat=\{0:N0\} ₽}" Width="150"/>
                                <DataGridTextColumn Header="Сбор за багаж" Binding="{Binding BaggageSum, StringFormat=\{0:N0\} ₽}" Width="140"/>
                                <DataGridTextColumn Header="Итоговая выручка" Binding="{Binding TotalRevenue, StringFormat=\{0:N0\} ₽}" Width="160" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Доля продаж" Binding="{Binding SalesSharePercent, StringFormat=\{0:0.0\}%}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="📊 Выгрузить в Excel (.xlsx)" Height="38" Padding="18,0" Background="#15803D" Foreground="White"
                                BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="ExportExcel_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Касса № 2 | Смена открыта: 08:00 | Оформлено сегодня: 14 билетов" Foreground="#64748B" FontSize="11.5"/>
                    <TextBlock x:Name="ClockTextBlock" Text="Текущее время: 31.10.2026 19:35" Foreground="#64748B" FontSize="11.5" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
</Window>
