<Window x:Class="AirlineTicketOffice.Views.ConfirmRefundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение возврата авиабилета" Height="280" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Margin="-20,-20,-20,15" Padding="16,12">
            <TextBlock Text="Подтверждение возврата авиабилета" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="1" Margin="10,0,10,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="40" Height="40" Background="#FEF3C7" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="⚠" Foreground="#D97706" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeaderQuestionTextBlock" Text="Вы действительно хотите оформить возврат билета № 555-2418901234?"
                           Foreground="#0F172A" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailsTextBlock" Text="Пассажир: Иванов А.П. | Рейс: SU-1124 (Москва → Сочи) | Место: 12A"
                           Foreground="#475569" FontSize="13" Margin="0,5,0,12"/>

                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="RefundCalcTextBlock" Text="К возврату клиенту: 5 850.00 ₽ (удержан сервисный сбор авиакомпании 600.00 ₽)."
                                   Foreground="#B91C1C" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SeatReleaseTextBlock" Text="После подтверждения место 12A снова станет доступным для продажи."
                                   Foreground="#991B1B" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="100" Height="36" Background="#F1F5F9" Foreground="#334155"
                    BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>
            <Button Content="Подтвердить возврат средств" Height="36" Padding="15,0" Background="#DC2626" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" IsDefault="True" Click="Confirm_Click">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
