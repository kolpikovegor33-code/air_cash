<Window x:Class="AirlineTicketOffice.Views.ValidationMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибка валидации данных" Height="210" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Margin="-20,-20,-20,15" Padding="16,10">
            <TextBlock Text="Ошибка валидации данных" Foreground="White" FontSize="13.5" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="1" Margin="10,0,10,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="40" Height="40" Background="#FEE2E2" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="✕" Foreground="#DC2626" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Некорректный ввод данных" Foreground="#991B1B" FontSize="15" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="MessageTextBlock" Text="Проверьте заполненность обязательных полей." Foreground="#475569" FontSize="13" TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Понятно" Width="100" Height="34" Background="#F1F5F9" Foreground="#334155"
                    BorderBrush="#CBD5E1" FontWeight="SemiBold" Cursor="Hand" IsDefault="True" IsCancel="True" Click="Close_Click">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
