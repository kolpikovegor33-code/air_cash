<Window x:Class="AirlineTicketOffice.Views.FlightEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление авиарейсом" Height="620" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="20,0">
            <TextBlock x:Name="HeaderTextBlock" Text="Добавление авиарейса в расписание"
                       Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,15,25,10">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Номер рейса * (напр. SU-1124):" Foreground="#334155" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="FlightNumberTextBox" Height="34" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Авиакомпания-перевозчик *:" Foreground="#334155" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AirlineComboBox" Height="34" FontSize="13" VerticalContentAlignment="Center" DisplayMemberPath="Title"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Аэропорт вылета *:" Foreground="#334155" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DepartureAirportComboBox" Height="34" FontSize="12.5" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Аэропорт прилёта *:" Foreground="#334155" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ArrivalAirportComboBox" Height="34" FontSize="12.5" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Тип воздушного судна *:" Foreground="#334155" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AircraftComboBox" Height="34" FontSize="12.5" VerticalContentAlignment="Center"
                                  DisplayMemberPath="Model" SelectionChanged="AircraftComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Статус рейса:" Foreground="#334155" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="StatusComboBox" Height="34" FontSize="12.5" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="По расписанию" IsSelected="True"/>
                            <ComboBoxItem Content="Задержка"/>
                            <ComboBoxItem Content="Отменён"/>
                            <ComboBoxItem Content="Посадка завершена"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Расписание отправления и прибытия" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Дата вылета *:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                <DatePicker x:Name="DepartureDatePicker" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Время вылета (ЧЧ:ММ):" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox x:Name="DepartureTimeTextBox" Height="34" Text="08:30" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Дата прилёта *:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                <DatePicker x:Name="ArrivalDatePicker" Height="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Время прилёта (ЧЧ:ММ):" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox x:Name="ArrivalTimeTextBox" Height="34" Text="12:15" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,12">
                    <StackPanel>
                        <TextBlock Text="Тарифная сетка и посадочные места" Foreground="#0F172A" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Тариф Эконом (₽) *:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox x:Name="BasePriceTextBox" Height="34" Text="6450" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Тариф Бизнес (₽) *:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox x:Name="BusinessPriceTextBox" Height="34" Text="18900" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Свободных мест *:" Foreground="#475569" FontSize="12" Margin="0,0,0,3"/>
                                <TextBox x:Name="FreeSeatsTextBox" Height="34" Text="42" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Button Content="Отмена" Width="100" Height="36" HorizontalAlignment="Left"
                        Background="White" Foreground="#475569" BorderBrush="#CBD5E1" FontWeight="SemiBold"
                        Cursor="Hand" Click="Cancel_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="💾 Сохранить рейс" Width="170" Height="36" HorizontalAlignment="Right"
                        Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Cursor="Hand" Click="Save_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
