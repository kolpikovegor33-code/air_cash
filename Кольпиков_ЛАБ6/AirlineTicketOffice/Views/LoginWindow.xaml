<Window x:Class="AirlineTicketOffice.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АИС «Авиакасса» — Вход в систему" Height="530" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F8FAFC" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="24,18">
            <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✈" Foreground="#38BDF8" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="АИС «Авиакасса»" Foreground="White" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Автоматизированная информационная система продажи авиабилетов"
                           Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Margin="30,20,30,16" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="28,22">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Вход в учетную запись" Foreground="#0F172A" FontSize="17" FontWeight="Bold" Margin="0,0,0,18"/>

                <TextBlock Text="Логин:" Foreground="#334155" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="LoginTextBox" Height="40" FontSize="14"
                         VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,16"
                         BorderBrush="#CBD5E1" KeyDown="LoginTextBox_KeyDown"/>

                <TextBlock Text="Пароль:" Foreground="#334155" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="40" FontSize="14"
                             VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,22"
                             BorderBrush="#CBD5E1" KeyDown="PasswordBox_KeyDown"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="LoginBtn" Content="Войти в систему" Height="42" Margin="0,0,12,0"
                            Background="#0284C7" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" FontSize="14" Cursor="Hand" IsDefault="True" Click="Login_Click">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="1" Content="Выход" Height="42"
                            Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1"
                            FontWeight="SemiBold" FontSize="13.5" Cursor="Hand" IsCancel="True" Click="Close_Click">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                
            </StackPanel>
        </Border>


    </Grid>
</Window>
